# Copy to .env and adjust. Never commit .env.
APP_ENV=dev
# LLM: "ollama" locally; in production e.g. "anthropic,openai" (fallback chain, Phase 7)
LLM_PROVIDERS=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Storage
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0
STORE=postgres
JOB_MODE=queue
# Security: required when APP_ENV=prod
API_KEY=change-me
MAX_INPUT_CHARS=8000
# Observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
MLFLOW_TRACKING_URI=http://localhost:5000
CLASSIFIER_MODEL_URI=models:/annex3-classifier@champion
