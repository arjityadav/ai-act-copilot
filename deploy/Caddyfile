# Caddy gets and renews a Let's Encrypt certificate for every name in $DOMAIN automatically
# (comma-separated, e.g. "ai-act-copilot.duckdns.org, 141.147.32.252.sslip.io").
#   /                     -> Streamlit UI (for people)
#   /docs, /chat, ...     -> FastAPI (for developers and the UI)
#   /metrics              -> blocked: Prometheus metrics are internal
{$DOMAIN} {
	encode gzip

	# Its own handle block: Caddy sorts directives by a fixed order in which `handle` runs before a
	# bare `respond`, so `respond @metrics 404` alone would never be reached. handle blocks are
	# mutually exclusive and evaluated in the order written.
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 404
	}

	@api path /docs /docs/* /openapi.json /redoc /health /ready /version /stats /chat /chat/* /assessments /assessments/* /feedback
	handle @api {
		reverse_proxy api:8000
	}

	# Everything else is the UI. Streamlit uses a websocket (/_stcore/stream); Caddy proxies it as-is.
	handle {
		reverse_proxy ui:8501
	}
}
