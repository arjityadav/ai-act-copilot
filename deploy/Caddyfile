# Caddy gets and renews a Let's Encrypt certificate for every name in $DOMAIN automatically
# (comma-separated, e.g. "ai-act-copilot.duckdns.org, 141.147.32.252.sslip.io").
#   /                     -> Streamlit UI (for people)
#   /docs, /chat, ...     -> FastAPI (for developers and the UI)
#   /metrics              -> blocked: Prometheus metrics are internal
{$DOMAIN} {
	encode gzip

	@metrics path /metrics /metrics/*
	respond @metrics 404

	@api path /docs /docs/* /openapi.json /redoc /health /ready /stats /chat /chat/* /assessments /assessments/* /feedback
	handle @api {
		reverse_proxy api:8000
	}

	# Everything else is the UI. Streamlit uses a websocket (/_stcore/stream); Caddy proxies it as-is.
	handle {
		reverse_proxy ui:8501
	}
}
