# Copy to .env.prod ON THE SERVER and fill in. Never commit .env.prod (it is gitignored).
DOMAIN=130-61-1-2.sslip.io               # your server's public IP with dashes + .sslip.io (or your own domain)
API_KEY=                                 # long random string: openssl rand -hex 32
POSTGRES_PASSWORD=                       # long random string: openssl rand -hex 24

# LLM: Groq free tier through the OpenAI-compatible API (no local LLM on the VM)
LLM_PROVIDERS=openai
OPENAI_API_KEY=                          # from console.groq.com -> API Keys
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=                            # a model id from console.groq.com -> Models
LLM_TIMEOUT_S=120
